          <div className="vault-balance-card indigo">
            <div className="vault-balance-label">My Deposit</div>
            <div className="vault-balance-value">{fmt(myDeposit)} <span style={{ fontSize: '0.65rem' }}>USDC</span></div>
          </div>
          <div className="vault-balance-card violet">
            <div className="vault-balance-label">Claimable</div>
            <div className="vault-balance-value">{fmt(myClaim)} <span style={{ fontSize: '0.65rem' }}>USDC</span></div>
          </div>
        </div>
      )}

      {/* Deposit */}
      <div className="vault-section indigo-border">
        <div className="vault-section-title">Deposit USDC</div>
        <div className="cc-row">
          <input value={depositAmt} onChange={e => setDepositAmt(e.target.value)} placeholder="Amount (USDC)" type="number" step="0.1" className="vault-input" />
          <button onClick={doDeposit} disabled={!!sending || !depositAmt} className="vault-icon-btn">
            {sending === 'Deposit' ? '⏳' : '⬆️'}
          </button>
        </div>
      </div>

      {/* Request withdrawal */}
      <div className="vault-section violet-border">
        <div className="vault-section-title">Request Withdrawal</div>
        <div className="vault-hint">Deducted from your deposit. 2 signers must approve. 0.10 USDC fee.</div>
        <div className="cc-row">
          <input value={withdrawAmt} onChange={e => setWithdrawAmt(e.target.value)} placeholder="Amount (USDC, min 0.11)" type="number" step="0.01" className="vault-input" />
          <button onClick={doRequest} disabled={!!sending || !withdrawAmt} className="vault-icon-btn" style={{ background: '#7c3aed' }}>
            {sending === 'Withdrawal Request' ? '⏳' : '📤'}
          </button>
        </div>
      </div>

      {/* Execute / claim */}
      <div className="vault-section purple-border">
        <div className="vault-section-title">Execute Approved Withdrawal</div>
        <div className="cc-row">
          <input value={reqId} onChange={e => setReqId(e.target.value)} placeholder="Request ID" type="number" className="vault-input" />
          <button onClick={doExecute} disabled={!!sending || !reqId} className="vault-icon-btn" style={{ background: '#9333ea' }}>
            {sending === 'Execute' ? '⏳' : '✅'}
          </button>
        </div>
        {myClaim > 0n && (
          <button onClick={doClaim} disabled={!!sending} className="vault-claim-btn">
            {sending === 'Claim' ? '⏳ Claiming…' : `💰 Claim ${fmt(myClaim)} USDC`}
          </button>
        )}
      </div>
    </div>
  )
}

