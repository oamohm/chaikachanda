// ─── Connect Button ───────────────────────────────────────────────────────────
// Uses ConnectKit's useModal to open the standard wallet picker modal.
// When connected: opens the account modal for disconnect / chain switch.
function ConnectButton() {
  const { isConnected, address } = useAccount()
  const { setOpen }              = useModal()

  if (isConnected && address) {
    return (
      <button
        onClick={() => setOpen(true)}
        style={{
          background: 'rgba(200,109,59,0.18)',
          border: '1px solid rgba(200,109,59,0.45)',
          borderRadius: 20,
          color: '#F1C40F',
          fontSize: 12,
          fontWeight: 700,
          padding: '6px 14px',
          cursor: 'pointer',
          fontFamily: 'Space Grotesk, sans-serif',
          letterSpacing: '0.04em',
        }}
      >
        {address.slice(0, 6)}…{address.slice(-4)} ▾
      </button>
    )
  }

  return (
    <button
      onClick={() => setOpen(true)}
      style={{
        background: 'linear-gradient(135deg, #2775CA 0%, #1a5faa 100%)',
        border: 'none',
        borderRadius: 20,
        color: '#fff',
        fontSize: 12,
        fontWeight: 700,
        padding: '7px 16px',
        cursor: 'pointer',
        fontFamily: 'Space Grotesk, sans-serif',
        letterSpacing: '0.04em',
        boxShadow: '0 2px 12px rgba(39,117,202,0.4)',
      }}
    >
      💙 Connect Wallet
    </button>
  )
}

// ─── Tab 1: Tapri Counter ──────────────────────────────────────────────────────
function TapriTab({ address, chainId, lang }: { address?: Hex; chainId?: number; lang: Lang }) {
  const s = STR[lang]
  const [cart,           setCart]           = useState<Record<string, number>>({})
  const [buyerName,      setBuyerName]      = useState('')
  const [orderMode,      setOrderMode]      = useState<'dine' | 'takeaway'>('dine')
  const [tipAmt,         setTipAmt]         = useState<string | null>(null)
  const [step,           setStep]           = useState<'idle' | 'sending' | 'done'>('idle')
  const [lastTx,         setLastTx]         = useState<string | null>(null)
  const [lastOrderId,    setLastOrderId]    = useState<bigint | null>(null)
  const [totalCollected, setTotalCollected] = useState<bigint | null>(null)
  const [orderCount,     setOrderCount]     = useState<bigint | null>(null)
  const { data: walletClient } = useWalletClient()

  const cartTotal = Object.entries(cart).reduce((acc, [key, qty]) => {
    const item = MENU_ITEMS.find(m => m.key === key)
    return acc + (item ? item.price * BigInt(qty) : 0n)
  }, 0n)

  const tipTotal = tipAmt ? parseEther(tipAmt) : 0n
  const grandTotal = cartTotal + tipTotal

  const itemsStr = [
    ...Object.entries(cart)
      .filter(([, q]) => q > 0)
      .map(([k, q]) => `${MENU_ITEMS.find(m => m.key === k)?.name ?? k} x${q}`),
    tipAmt ? `Tip ₹${tipAmt} USDC` : '',
    `[${orderMode === 'dine' ? 'Dine-In' : 'Takeaway'}]`,
  ].filter(Boolean).join(', ')

  useEffect(() => {
    const fetchStats = async () => {
      try {
        const [tc, oc] = await Promise.all([
          arcClient.readContract({ ...TAPRI, functionName: 'totalCollected' }),
          arcClient.readContract({ ...TAPRI, functionName: 'orderCount' }),
        ])
        setTotalCollected(tc)
        setOrderCount(oc)
      } catch { /* silent */ }
    }
    void fetchStats()
    const id = setInterval(() => void fetchStats(), 5000)
    return () => clearInterval(id)
  }, [])

  const placeOrder = useCallback(async () => {
    if (!walletClient || !address || chainId !== ARC_CHAIN_ID) {
      toast.error('Connect wallet on Arc Testnet first'); return
    }
    if (grandTotal === 0n) { toast.error('Add items or a tip first'); return }
    setStep('sending')
    try {
      const hash = await walletClient.writeContract({
        ...TAPRI,
        functionName: 'placeOrder',
        args: [buyerName || shortAddr(address), itemsStr],
        value: grandTotal,
        account: address,
        chain: null,
      })
      setLastTx(hash)
      toast.success('Order placed! Confirming…')
      const receipt = await arcClient.waitForTransactionReceipt({ hash })
      const log = receipt.logs[0]
      if (log?.topics[2]) setLastOrderId(BigInt(log.topics[2]))
      setStep('done')
      setCart({})
      setBuyerName('')
      toast.success('Order confirmed onchain!')
    } catch (e: unknown) {
      toast.error(e instanceof Error ? e.message.slice(0, 80) : 'Transaction failed')
      setStep('idle')
    }
  }, [walletClient, address, chainId, grandTotal, buyerName, itemsStr])

  return (
    <div className="cc-col">
      {/* ── Stats ── */}
      <div className="cc-grid-2">
        <div className="stat-card-amber">
          <div className="stat-label">{s.totalCollected}</div>
          <div className="stat-value">
            {totalCollected !== null ? fmt(totalCollected) : '0.0000'}
            <span> USDC</span>
          </div>
        </div>
        <div className="stat-card-amber">
          <div className="stat-label">{s.orders}</div>
          <div className="stat-value">
            {orderCount !== null ? orderCount.toString() : '0'}
          </div>
        </div>
      </div>

      {/* ── Order Mode Selector ── */}
      <div className="order-mode-bar">
        <button
          className={`mode-btn${orderMode === 'dine' ? ' active' : ''}`}
          onClick={() => setOrderMode('dine')}
        >{s.dineIn}</button>
        <button
          className={`mode-btn${orderMode === 'takeaway' ? ' active' : ''}`}
          onClick={() => setOrderMode('takeaway')}
        >{s.takeaway}</button>
      </div>

      {/* ── Menu Board ── */}
      <div className="tapri-menu-board">
        <div className="menu-board-title">🏺 माधु की दुकान — Price in USDC</div>
        <div className="cc-menu-grid">
          {MENU_ITEMS.map(item => (
            <div key={item.key} className="menu-item-row">
              <div className="menu-item-left">
                <span className="item-emoji">{item.emoji}</span>
                <div>
                  <div className="item-name">{item.name}</div>
                  <div className="item-price">💙 {fmt(item.price)} USDC</div>
                </div>
              </div>
              <div className="qty-controls">
                <button
                  className="qty-btn"
                  onClick={() => setCart(c => ({ ...c, [item.key]: Math.max(0, (c[item.key] ?? 0) - 1) }))}
                >−</button>
                <span className="qty-count">{cart[item.key] ?? 0}</span>
                <button
                  className="qty-btn qty-add"
                  onClick={() => setCart(c => ({ ...c, [item.key]: (c[item.key] ?? 0) + 1 }))}
                >+</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* ── Cart Ticket ── */}
      {cartTotal > 0n && (
        <div className="cart-ticket">
          <div className="ticket-header">🎫 Order Ticket / USDC Pay</div>
          {Object.entries(cart).filter(([, q]) => q > 0).map(([k, q]) => {
            const item = MENU_ITEMS.find(m => m.key === k)!
            return (
              <div key={k} className="ticket-line">
                <span>{item.emoji} {item.name} × {q}</span>
                <span className="ticket-price">{fmt(item.price * BigInt(q))} USDC</span>
              </div>
            )
          })}
          {/* ── Tip Jar Presets ── */}
          <div className="tip-label">{s.tipTitle}</div>
          <div className="tip-pills">
            {['0.25','0.50','1.00','5.00'].map(v => (
              <button
                key={v}
                onClick={() => setTipAmt(prev => prev === v ? null : v)}
                className={`tip-pill${tipAmt === v ? ' active' : ''}`}
              >+{v}</button>
            ))}
          </div>
          <hr className="ticket-divider" />
          <div className="ticket-total-row">
            <span>TOTAL</span>
            <span className="ticket-total">{fmt(grandTotal)} USDC</span>
          </div>
          <input
            value={buyerName}
            onChange={e => setBuyerName(e.target.value)}
            maxLength={30}
            placeholder="Your name (optional)"
            className="buyer-input"
          />
          <button
            onClick={() => void placeOrder()}
            disabled={step === 'sending'}
            className="cta-btn"
          >
            {step === 'sending' ? '⏳ Placing Order…' : s.placeOrder}
          </button>
        </div>
      )}

      {/* ── Success Receipt ── */}
      {step === 'done' && lastTx && (
        <div className="order-receipt">
          <div className="receipt-title">✅ Order Confirmed!</div>
          {lastOrderId !== null && <div className="receipt-id">Order #{lastOrderId.toString()}</div>}
          <a
            href={explorerTx(lastTx)}
            target="_blank"
            rel="noopener noreferrer"
            style={{ color: '#86efac', fontSize: 11, textDecoration: 'underline', display: 'block', marginBottom: 10 }}
          >View on Explorer ↗</a>
          <button
            onClick={() => setStep('idle')}
            style={{ fontSize: 12, color: '#86efac', textDecoration: 'underline', background: 'none', border: 'none', cursor: 'pointer' }}
          >+ New Order</button>
        </div>
      )}

      {/* ── Bahi-Khata ── */}
      <BahiKhata lang={lang} />

      {/* ── Coupon ── */}
      <CouponCard lang={lang} />

      {/* ── Gift Chai ── */}
      <GiftChai address={address} chainId={chainId} lang={lang} />
    </div>
  )
}

// ─── Tab 2: A2 Dairy Ledger ────────────────────────────────────────────────────
function DairyTab({ address, chainId }: { address?: Hex; chainId?: number }) {
  const [entries, setEntries] = useState<Array<{
    productType: number; quantityMl: bigint; priceWei: bigint; timestamp: bigint; note: string
  }>>([])
  const [form,    setForm]    = useState({ productType: 0, quantityMl: '', priceWei: '', note: '' })
  const [sending, setSending] = useState(false)
  const { data: walletClient } = useWalletClient()
  const isOwner = address?.toLowerCase() === OWNER.toLowerCase()

  const fetchEntries = useCallback(async () => {
    try {
      const count = await arcClient.readContract({ ...DAIRY, functionName: 'getEntryCount' })
      const items = await Promise.all(
        Array.from({ length: Number(count) }, (_, i) =>
          arcClient.readContract({ ...DAIRY, functionName: 'getEntry', args: [BigInt(i)] })
        )
      )
      setEntries(items)
    } catch { /* silent */ }
  }, [])

  useEffect(() => {
    const run = () => { void fetchEntries() }
    run()
    const id = setInterval(run, 8000)
    return () => clearInterval(id)
  }, [fetchEntries])

  const addEntry = useCallback(async () => {
    if (!walletClient || !address || chainId !== ARC_CHAIN_ID) { toast.error('Connect wallet on Arc Testnet'); return }
    if (!isOwner) { toast.error('Only the owner can add entries'); return }
    if (!form.quantityMl || !form.priceWei) { toast.error('Fill in quantity and price'); return }
    setSending(true)
    try {
      const hash = await walletClient.writeContract({
        ...DAIRY,
        functionName: 'addEntry',
        args: [form.productType, BigInt(form.quantityMl), parseEther(form.priceWei), form.note],
        account: address,
        chain: null,
      })
      await arcClient.waitForTransactionReceipt({ hash })
      toast.success('Entry added to ledger!')
      setForm({ productType: 0, quantityMl: '', priceWei: '', note: '' })
      void fetchEntries()
    } catch (e: unknown) {
      toast.error(e instanceof Error ? e.message.slice(0, 80) : 'Transaction failed')
    } finally { setSending(false) }
  }, [walletClient, address, chainId, isOwner, form, fetchEntries])

  return (
    <div className="cc-col">
      {/* Header */}
      <div className="dairy-header">
        <div style={{ color: '#6ee7b7', fontSize: 14, fontWeight: 800, fontFamily: 'Space Grotesk, sans-serif', textTransform: 'uppercase', letterSpacing: '0.08em', marginBottom: 4 }}>
          🐄 A2 Dairy Ledger
        </div>
        <div style={{ color: 'rgba(110,231,183,0.65)', fontSize: 12 }}>
          On-chain milk &amp; ghee records. Owner-only writes. Public reads.
        </div>
      </div>

      {/* Owner form */}
      {isOwner && (
        <div className="dairy-form">
          <div style={{ color: '#4ade80', fontSize: 11, fontWeight: 800, textTransform: 'uppercase', letterSpacing: '0.1em', fontFamily: 'Space Grotesk, sans-serif' }}>
            Add New Entry
          </div>
          <select
            value={form.productType}
            onChange={e => setForm(f => ({ ...f, productType: Number(e.target.value) }))}
            className="dairy-input"
          >
            {PRODUCT_LABELS.map((l, i) => <option key={i} value={i}>{l}</option>)}
          </select>
          <div className="dairy-grid-2">
            <input
              value={form.quantityMl}
              onChange={e => setForm(f => ({ ...f, quantityMl: e.target.value }))}
              placeholder="Qty (ml)"
              type="number"
              className="dairy-input"
            />
            <input
              value={form.priceWei}
              onChange={e => setForm(f => ({ ...f, priceWei: e.target.value }))}
              placeholder="Price (USDC)"
              type="number"
              step="0.01"
              className="dairy-input"
            />
          </div>
          <input
            value={form.note}
            onChange={e => setForm(f => ({ ...f, note: e.target.value }))}
            placeholder="Note (e.g. 'Morning batch, Gir cow')"
            className="dairy-input"
          />
          <button onClick={() => void addEntry()} disabled={sending} className="dairy-btn">
            {sending ? '⏳ Adding…' : '➕ Add Entry'}
          </button>
        </div>
      )}

      {/* Entries list */}
      {entries.length === 0 ? (
        <div style={{ textAlign: 'center', color: 'rgba(74,222,128,0.4)', fontSize: 13, padding: '24px 0' }}>
          No entries yet.
        </div>
      ) : (
        <div className="cc-col">
          {[...entries].reverse().map((e, i) => (
            <div key={i} className="dairy-entry">
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                <div>
                  <div style={{ color: '#86efac', fontWeight: 700, fontSize: 14 }}>{PRODUCT_LABELS[e.productType]}</div>
                  <div style={{ color: 'rgba(134,239,172,0.6)', fontSize: 11, marginTop: 2 }}>{e.note || 'No note'}</div>
                </div>
                <div style={{ textAlign: 'right' }}>
                  <div style={{ color: '#4ade80', fontWeight: 700, fontSize: 14 }}>{e.quantityMl.toString()} ml</div>
                  <div style={{ color: '#fbbf24', fontSize: 11 }}>{fmt(e.priceWei)} USDC</div>
                </div>
              </div>
              <div style={{ color: 'rgba(74,222,128,0.4)', fontSize: 10, marginTop: 6 }}>
                {new Date(Number(e.timestamp) * 1000).toLocaleString()}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  )
}

// ─── Tab 3: Desi Smart Vault ───────────────────────────────────────────────────
function VaultTab({ address, chainId }: { address?: Hex; chainId?: number }) {
  const [myDeposit,   setMyDeposit]   = useState<bigint>(0n)
  const [myClaim,     setMyClaim]     = useState<bigint>(0n)
  const [depositAmt,  setDepositAmt]  = useState('')
  const [withdrawAmt, setWithdrawAmt] = useState('')
  const [reqId,       setReqId]       = useState('')
  const [sending,     setSending]     = useState<string | null>(null)
  const { data: walletClient } = useWalletClient()
  const VAULT_FEE = parseEther('0.1')

  const fetchBalances = useCallback(async () => {
    if (!address) return
    try {
      const [dep, claim] = await Promise.all([
        arcClient.readContract({ ...VAULT, functionName: 'deposits',  args: [address] }),
        arcClient.readContract({ ...VAULT, functionName: 'claimable', args: [address] }),
      ])
      setMyDeposit(dep)
      setMyClaim(claim)
    } catch { /* silent */ }
  }, [address])

  useEffect(() => {
    const run = () => { void fetchBalances() }
    run()
    const id = setInterval(run, 5000)
    return () => clearInterval(id)
  }, [fetchBalances])

  const send = useCallback(async (label: string, fn: () => Promise<Hex>) => {
    if (!address || chainId !== ARC_CHAIN_ID) { toast.error('Connect wallet on Arc Testnet'); return }
    setSending(label)
    try {
      const hash = await fn()
      await arcClient.waitForTransactionReceipt({ hash })
      toast.success(`${label} confirmed!`)
      void fetchBalances()
    } catch (e: unknown) {
      toast.error(e instanceof Error ? e.message.slice(0, 80) : 'Transaction failed')
    } finally { setSending(null) }
  }, [address, chainId, fetchBalances])

  const doDeposit  = () => void send('Deposit',              async () => walletClient!.writeContract({ ...VAULT, functionName: 'deposit',           value: parseEther(depositAmt),              account: address!, chain: null }))
  const doRequest  = () => void send('Withdrawal Request',   async () => { const amt = parseEther(withdrawAmt); if (amt <= VAULT_FEE) throw new Error('Amount must be > 0.10 USDC (fee)'); return walletClient!.writeContract({ ...VAULT, functionName: 'requestWithdrawal', args: [amt],           account: address!, chain: null }) })
  const doExecute  = () => void send('Execute',              async () => walletClient!.writeContract({ ...VAULT, functionName: 'executeWithdrawal', args: [BigInt(reqId)],                       account: address!, chain: null }))
  const doClaim    = () => void send('Claim',                async () => walletClient!.writeContract({ ...VAULT, functionName: 'claim',             account: address!, chain: null }))

  return (
    <div className="cc-col">
      {/* Header */}
      <div className="vault-card">
        <div className="vault-title">🏦 Desi Smart Vault</div>
        <div style={{ color: 'rgba(165,180,252,0.65)', fontSize: 12, marginTop: 4 }}>
