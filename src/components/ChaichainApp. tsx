// ─── Bahi-Khata: On-Chain Ledger Feed ────────────────────────────────────────
function BahiKhata({ lang }: { lang: Lang }) {
  const s = STR[lang]
  const [entries, setEntries] = useState<Array<{ buyer: string; amount: bigint; orderId: bigint }>>([])

  useEffect(() => {
    const fetch = async () => {
      try {
        const blockNumber = await arcClient.getBlockNumber()
        const fromBlock   = blockNumber > 500n ? blockNumber - 500n : 0n
        const logs = await arcClient.getLogs({
          address: TAPRI.address,
          fromBlock,
          toBlock: 'latest',
        })
        const parsed = logs.slice(-8).reverse().map(l => ({
          buyer:   (l.topics[1] ? `0x${l.topics[1].slice(26)}` : ''),
          amount:  0n,
          orderId: l.topics[2] ? BigInt(l.topics[2]) : 0n,
        }))
        setEntries(parsed)
      } catch { /* silent */ }
    }
    void fetch()
    const id = setInterval(() => void fetch(), 12000)
    return () => clearInterval(id)
  }, [])

  return (
    <div className="bahi-khata">
      <div className="bahi-title">{s.bahiTitle}</div>
      <div className="bahi-sub">{s.bahiSub}</div>
      {entries.length === 0
        ? <div className="bahi-empty">{s.noEntries}</div>
        : entries.map((e, i) => (
          <div key={i} className="bahi-row">
            <div className="bahi-left">
              <span className="bahi-id">#{e.orderId.toString()}</span>
              <span className="bahi-addr">{shortAddr(e.buyer)}</span>
            </div>
            <div className="bahi-right">
              <span className="bahi-amt">{fmt(e.amount)} USDC</span>
            </div>
          </div>
        ))
      }
    </div>
  )
}

