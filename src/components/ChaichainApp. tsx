// ─── Gift Chai ────────────────────────────────────────────────────────────────
function GiftChai({ address, chainId, lang }: { address?: Hex; chainId?: number; lang: Lang }) {
  const s = STR[lang]
  const [giftTo,   setGiftTo]   = useState('')
  const [giftAmt,  setGiftAmt]  = useState('0.50')
  const [sending,  setSending]  = useState(false)
  const { data: walletClient }  = useWalletClient()

  const sendGift = useCallback(async () => {
    if (!walletClient || !address || chainId !== ARC_CHAIN_ID) { toast.error('Connect wallet on Arc Testnet'); return }
    if (!giftTo.startsWith('0x') || giftTo.length !== 42) { toast.error('Enter a valid wallet address'); return }
    setSending(true)
    try {
      const hash = await walletClient.writeContract({
        ...TAPRI,
        functionName: 'placeOrder',
        args: [`Gift→${giftTo.slice(0,6)}`, `Gift Chai ${giftAmt} USDC for ${giftTo}`],
        value: parseEther(giftAmt),
        account: address,
        chain: null,
      })
      await arcClient.waitForTransactionReceipt({ hash })
      toast.success('🎁 Gift chai sent onchain!')
      setGiftTo('')
    } catch (e: unknown) {
      toast.error(e instanceof Error ? e.message.slice(0, 80) : 'Transaction failed')
    } finally { setSending(false) }
  }, [walletClient, address, chainId, giftTo, giftAmt])

  return (
    <div className="gift-chai-card">
      <div className="gift-title">{s.giftTitle}</div>
      <div className="gift-title-hi">{s.giftTitleHi}</div>
      <div className="gift-presets">
        {['0.25','0.50','1.00','2.00'].map(v => (
          <button key={v} onClick={() => setGiftAmt(v)} className={`gift-preset${giftAmt === v ? ' active' : ''}`}>
            {v} USDC
          </button>
        ))}
      </div>
      <input
        value={giftTo}
        onChange={e => setGiftTo(e.target.value)}
        placeholder={s.giftTo}
        className="gift-input"
      />
      <button onClick={() => void sendGift()} disabled={sending} className="gift-btn">
        {sending ? '⏳ Sending…' : s.giftSend}
      </button>
    </div>
  )
}

